# ==========================================
# Yoga with Dhaarna - Environment Configuration
# ==========================================

# 1. ONLINE DATABASE (Supabase / Neon PostgreSQL)
# Get your free database URL at https://supabase.com
# Go to Project Settings -> Database -> Connection string (Node.js / Prisma)
# Replace [YOUR-PASSWORD] with your database password:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# 2. ADMIN AUTHENTICATION
JWT_SECRET="yoga_with_dhaarna_secure_jwt_secret_key_2026_super_safe"
ADMIN_DEFAULT_EMAIL="dhaarna@yogawithdhaarna.com"
ADMIN_DEFAULT_PASSWORD="admin_password_123"

# 3. NOTIFICATIONS
INSTRUCTOR_EMAIL="dhaarna@yogawithdhaarna.com"
# Optional Discord or Telegram webhook for real-time mobile push notifications:
DISCORD_WEBHOOK_URL=""

# 4. APP URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 5. GOOGLE GEMINI AI CONCIERGE ("Prana")
# Get your free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
