# ==========================================
# Yoga Platform - Environment Configuration
# ==========================================

# 1. ONLINE DATABASE (Supabase / PostgreSQL)
# Vercel Serverless connects via Supavisor Transaction Pooler on port 6543
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct URL on port 5432 for Prisma CLI migrations
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# 2. ADMIN AUTHENTICATION
JWT_SECRET="your_secure_jwt_secret_key_minimum_32_characters"
ADMIN_DEFAULT_EMAIL="admin@example.com"
ADMIN_DEFAULT_PASSWORD="change_this_to_a_strong_password"

# 3. NOTIFICATIONS & EMAIL (Resend)
# Get a free API key at https://resend.com (3,000 free emails/month)
RESEND_API_KEY=""
# Default sandbox sender or verified custom domain:
EMAIL_FROM="Yoga Platform <onboarding@resend.dev>"
INSTRUCTOR_EMAIL="instructor@example.com"

# Optional Discord, Telegram, or Slack webhook for instant mobile push alerts:
DISCORD_WEBHOOK_URL=""

# 4. APP URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 5. GOOGLE GEMINI AI CONCIERGE ("Prana")
# Get your free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
